{
  "name": "dsh-pixelfly",
  "version": "0.2.0",
  "type": "module",
  "description": "PixelFly for DeepSeek Harness: a single-workspace image studio on top of an OpenAI-compatible upstream, with a rotating multi-key ring, exponential backoff with jitter, a vision-model planner and a version tree of every result.",
  "license": "MIT",
  "author": "Qinqing1999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qinqing1999/dsh-pixelfly.git"
  },
  "homepage": "https://github.com/Qinqing1999/dsh-pixelfly#readme",
  "bugs": {
    "url": "https://github.com/Qinqing1999/dsh-pixelfly/issues"
  },
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pixelfly",
    "image-generation",
    "text-to-image",
    "image-editing",
    "sensenova"
  ],
  "exports": {
    ".": "./host/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host/index.js",
    "host/config.js",
    "host/upstream.js",
    "host/raster.js",
    "host/vision.js",
    "host/store.js",
    "host/providers.js",
    "host/operations.js",
    "host/session.js",
    "host/tools.js",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
